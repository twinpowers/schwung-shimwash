{
 "title": "Shimwash",
 "children": [
  {"title": "Overview", "lines": [
    "Shimmer reverb: two",
    "pitch shifters that",
    "climb through a big,",
    "dark reverb. Built",
    "for shoegaze washes."]},
  {"title": "Main", "lines": [
    "Mix: dry/wet.",
    "Length: decay time,",
    "0.8 s to 60 s.",
    "Size: room scale.",
    "Color: tail bright-",
    "ness, dark to open.",
    "M.Rate/M.Amt: speed",
    "and depth of the",
    "tail's slow drift.",
    "Predly: delay before",
    "the reverb, in ms.",
    "Bloom: fades chords",
    "in slowly instead",
    "of hitting at once."]},
  {"title": "Shft A", "lines": [
    "Pitch: -24 to +24",
    "semitones.",
    "Fine: +/-100 cents.",
    "Delay: echo on the",
    "pitched sound, up to",
    "1000 ms.",
    "Mode: PRE shifts the",
    "input into the",
    "reverb. FDBK feeds",
    "the reverb's output",
    "back in - classic",
    "shimmer. POST adds",
    "the pitch to the",
    "output only.",
    "Amt: how much.",
    "Pan: where it sits."]},
  {"title": "Shft B", "lines": [
    "Same controls as",
    "Shft A, fully",
    "independent.",
    "",
    "Defaults: A is +12,",
    "B is +7, both FDBK.",
    "Try B at -12 for a",
    "dark undertow, or",
    "set one to POST to",
    "keep it out of the",
    "reverb's loop."]},
  {"title": "Wash", "lines": [
    "Tone: darkness of",
    "the shimmer path.",
    "Locut: keeps bass",
    "out of the shimmer.",
    "Spread: stereo width",
    "of the reverb.",
    "Freeze: holds the",
    "wash. Input stops,",
    "the tail sustains."]},
  {"title": "Input", "lines": [
    "Gain: level into the",
    "reverb, +/-12 dB.",
    "Type: HP or LP.",
    "Freq: filter corner,",
    "20 Hz to 20 kHz.",
    "LP at the very",
    "bottom cuts it all.",
    "Q: filter resonance.",
    "The filter only",
    "affects the reverb",
    "send, not your dry",
    "sound."]},
  {"title": "Duck", "lines": [
    "Lowers the reverb",
    "while you play, lets",
    "it bloom when you",
    "stop.",
    "Depth: 0 is off.",
    "Thresh: level that",
    "starts ducking.",
    "Attack: how fast it",
    "ducks.",
    "Rel: how fast the",
    "reverb comes back."]},
  {"title": "Preset", "lines": [
    "INIT restores the",
    "defaults, then 13",
    "factory programs.",
    "",
    "Recall sets every",
    "control except",
    "Freeze - that one is",
    "yours to play."]}
 ]
}
